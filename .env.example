# ---------------------------------------------------------------- local dev
# With nothing set below, the app runs entirely on this machine: SQLite in
# data/stemhub.db, PDFs in data/uploads, and email captured in the Inbox tab
# instead of being sent. Copy this file to .env.local and fill in what you need.

APP_URL=http://localhost:3000

# ------------------------------------------------------------------- email
# Gmail needs an App Password (https://myaccount.google.com/apppasswords) —
# your normal password will not work. Leave blank to keep mail in the Inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=STEM Desk <you@gmail.com>

# ---------------------------------------------------------------- deployed
# Set these on the host, not locally, unless you want to develop against the
# real database. See "Deploying" in README.md.

# Postgres. Any provider: Supabase, Neon, Vercel Postgres. Use the *pooled*
# connection string on serverless hosts.
DATABASE_URL=

# Supabase Storage, for the spread PDFs. Create a PRIVATE bucket named
# "spreads". The service role key is secret — never expose it to the browser.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=spreads

# Protects the scheduled digest. Vercel sends this automatically as a bearer
# token once it is set as an environment variable.
CRON_SECRET=

# Protects POST /api/digest, if you drive the digest from your own cron.
DIGEST_SECRET=
