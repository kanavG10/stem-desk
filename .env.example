# Where the app is reachable — used for links inside emails.
APP_URL=http://localhost:3000

# Leave SMTP blank to run in Outbox mode: every notification is captured in the
# app's Inbox tab exactly as it would be sent, but nothing leaves the building.
#
# Gmail: make an App Password at https://myaccount.google.com/apppasswords
# (a normal account password will not work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=STEM Desk <you@gmail.com>

# Optional: require this header on POST /api/digest once the app is deployed.
DIGEST_SECRET=
